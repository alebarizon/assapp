# AssApp — Produção (DigitalOcean :80)
# Copiado para .env.production no servidor (não versionar .env.production)

SECRET_KEY=CHANGE_THIS_TO_A_STRONG_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=159.203.183.184,gesttora.com.br,www.gesttora.com.br,gesttora.vertent.com.br,localhost,127.0.0.1
BASE_DOMAIN=assapp.local

POSTGRES_DB=assapp_db_prod
POSTGRES_USER=assapp_user_prod
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

VITE_API_URL=

DOCKER_USERNAME=alebarizon
IMAGE_TAG=latest

GUNICORN_WORKERS=2
SYSTEM_TENANT_SCHEMA=sistema

# Base dos links enviados por e-mail (convites, definir senha, certificados)
FRONTEND_URL=http://gesttora.com.br

# E-mail — console só registra no log; para envio real use smtp
# Com o secret SMTP_PASSWORD no GitHub, o deploy de produção preenche o bloco SMTP (DreamHost,
# via serviço smtp_tunnel — a DigitalOcean bloqueia SMTP de saída)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=core.email_backend.CotaSMTPBackend
EMAIL_HOST=smtp.dreamhost.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@gesttora.com.br
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=15
# Destinatários/hora para newsletter, réguas e lembretes (DreamHost bloqueia acima de 100/hora). 0 = sem limite
EMAIL_LIMITE_POR_HORA=70
SMTP_TUNNEL_USER=gesttora
SMTP_TUNNEL_HOST=pdx1-shared-a1-07.dreamhost.com
DEFAULT_FROM_EMAIL=noreply@gesttora.com.br
# Caixa que recebe avisos de chamados de suporte (vazio = sem aviso)
SUPPORT_EMAIL=contato@gesttora.com.br
# Serviço `agendador`: ritmo da newsletter (e-mails por minuto, somando todas as associações)
NEWSLETTER_POR_MINUTO=30
# Hora (Brasília) da régua diária de anuidades
REGUA_HORA=8

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
